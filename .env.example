# ===== 必填 =====
MEDIA_ROOT=/media
JWT_SECRET_KEY=change-me
MANAGE_PASSWORD=change-me
CLOUD189_USERNAME=
CLOUD189_PASSWORD=
CLOUD189_TARGET_FOLDER_ID=

# ===== 可选 =====
# B站 cookie 推荐在管理后台配置（会过期，后台可随时更新）。以下仅在后台未配置时作为兜底：
# 订阅 cookie：SESSDATA 的值，用于读取关注分组和动态
# FO_COOKIE=
# 下载 cookie：yt-dlp 使用的 Netscape 格式 cookies.txt（容器内路径）
# DL_COOKIE_FILE=/app/cookies.txt

# SQLite 数据库文件（容器内路径，所在目录需挂载到宿主机，见 docker-compose.yml）
# DB_PATH=/data/bdm.db
# TZ=Asia/Shanghai
# LOG_LEVEL=INFO

# 本地文件的外部访问前缀，例如 https://example.com:8000/file ，留空则不返回本地播放地址
# LOCAL_FILE_URL_PREFIX=

# 关注分组：BILI_MID 为账号 uid，BILI_FOLLOW_TAG_ID 为要监听的分组 id
# BILI_MID=543741
# BILI_FOLLOW_TAG_ID=37444368
# MAX_DYNAMIC_FETCH_PAGE=10

# API
# API_WORKERS=2
# JWT_COOKIE_SECURE=true

# 每轮处理数量（CONCURRENT_TASK_NUM 为旧配置名，仍然兼容）
# DOWNLOAD_BATCH=3
# UPLOAD_BATCH=5
# MATCH_BATCH=3

# 自动下载的时长范围（秒），精选稿件不受限制
# DOWNLOAD_MIN_DURATION=20
# DOWNLOAD_MAX_DURATION=600

# 重试与自动暂停
# MAX_DOWNLOAD_RETRY=3
# MAX_UPLOAD_RETRY=3
# UPLOAD_PAUSE_THRESHOLD=3

# 各阶段调度间隔与超时（分钟）
# FETCH_INTERVAL=15
# FETCH_TIMEOUT=10
# DOWNLOAD_INTERVAL=2
# DOWNLOAD_TIMEOUT=60
# UPLOAD_INTERVAL=1
# UPLOAD_TIMEOUT=120
# MATCH_INTERVAL=5
# MATCH_TIMEOUT=30
